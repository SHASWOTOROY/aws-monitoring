# Copy this file to .env and fill in values. Never commit .env.

# Required: region where your EC2 instances run
AWS_REGION=

# Authentication (choose one approach):
# Option A — long-term IAM user keys (rotate regularly; restrict with IAM policy)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Option B — if running on AWS with instance/task role, omit keys and attach IAM role instead

# Optional: session token when using temporary credentials (STS/SSO)
# AWS_SESSION_TOKEN=

# CORS: browser origin allowed to call this API (your React app URL)
# Dev: http://localhost:5173   Production: https://monitoring.yourdomain.com
FRONTEND_ORIGIN=http://localhost:5173

# Server port
PORT=3001

# Optional: restrict EC2 to instances with this tag key=value (empty = all running in region)
# INSTANCE_FILTER_TAG_KEY=Environment
# INSTANCE_FILTER_TAG_VALUE=Production

# Memory: keep false until CloudWatch Agent publishes mem_used_percent (no CW calls = no memory errors).
# IAM needs cloudwatch:GetMetricData and cloudwatch:ListMetrics (ListMetrics resolves the agent metric’s full dimension set).
CW_MEMORY_ENABLED=false

# Optional overrides when CW_MEMORY_ENABLED=true:
# CW_MEMORY_NAMESPACE=CWAgent
# CW_MEMORY_METRIC_NAME=mem_used_percent
# If the agent `host` tag still does not match EC2 DNS, add explicit hostnames (comma-separated):
# CW_MEMORY_EXTRA_HOST_CANDIDATES=my-hostname,other
