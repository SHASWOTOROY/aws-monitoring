# Company name shown next to the logo in the header (quote if it contains spaces)
VITE_COMPANY_NAME="Cloudly Infotech Limited"

# Dev only: must match server/.env PORT (default 3001 if unset).
# Example when API runs on 3002:
# VITE_API_PROXY_PORT=3002

# Optional: production API base URL (no trailing slash).
# Development: leave unset — Vite proxies /api to the backend.
# Example same host: leave empty and put the SPA + API behind one reverse proxy.
# Example split hosts:
# VITE_API_BASE=https://api.yourdomain.com
